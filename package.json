{
  "name": "queria",
  "version": "0.0.0-semantic-release",
  "description": "Query and visualize Queria open data in the browser with DuckDB WASM and MapLibre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queria-io/queria-js.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/elements/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "default": "./dist/elements/index.js"
    },
    "./elements/define": {
      "types": "./dist/elements/define.d.ts",
      "default": "./dist/elements/define.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
